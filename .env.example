# Ghost Agent Platform - environment variables consumed by
# docker-compose.yml. Copy this file to `.env` and fill in the
# values marked REQUIRED. Optional values can stay at the defaults
# shown.
#
# This file is committed; `.env` is gitignored - secrets stay local.

# ------------------------------------------------------------------
# Release tag (REQUIRED)
# ------------------------------------------------------------------

# The exo release version to deploy. All five exo-* images are pushed
# with the same tag. Pick a published `vX.Y.Z` tag from your Docker
# Hub access.
TAG=

# ------------------------------------------------------------------
# Image registry (optional)
# ------------------------------------------------------------------

# Default points at the canonical Docker Hub repos. Only override
# when pulling from a mirror or a local registry under the same
# namespace layout (.../exo-server, .../exo-credential-proxy, etc.).
# REGISTRY=docker.io/ghostsecurityhq

# Updater image tag, kept separate from TAG so an in-stack upgrade
# can bump the four managed services without recreating the updater
# container that's driving the upgrade. Empty falls back to TAG.
# UPDATER_TAG=

# Accept vX.Y.Z-<suffix> PRERELEASE tags as explicit upgrade targets.
# Prerelease tags are still never auto-advertised as "latest".
# Leave unset in production. Set to "true" to enable.
# EXO_UPDATER_ALLOW_PRERELEASE_TARGET=

# ------------------------------------------------------------------
# Worker scale (optional)
# ------------------------------------------------------------------

# Number of worker replicas. Each replica handles one concurrent
# workflow run. Scale based on expected concurrency.
WORKER_REPLICAS=2

# ------------------------------------------------------------------
# Secrets (REQUIRED)
# ------------------------------------------------------------------

# Encryption key for the credential-proxy. Used to encrypt every
# stored upstream credential at rest. Generate once with:
#
#   openssl rand -base64 32
#
# Rotating this key invalidates every stored credential - treat it
# like a database master key.
ENCRYPTION_KEY=

# JWT signing secret for session tokens. Supplied here (not in
# config.toml) so config.toml stays non-secret and the gateway can run
# as a non-root user. Generate once with:
#
#   openssl rand -base64 64
#
# Rotating this invalidates all active sessions. setup.sh fills this in.
EXO_JWT_SECRET=

# Initial admin password, used once on first boot to seed the admin user
# (matched with the [[seed.users]] email in config.toml). Supplied here
# rather than in config.toml so config.toml carries no secrets.
EXO_SEED_ADMIN_PASSWORD=

# Docker Hub Organization Access Token with Read on the exo-* repos.
# Used by the in-stack updater (exo-updater) to:
#   1. Poll Docker Hub for new release tags
#   2. Authenticate `docker compose pull` during in-place upgrades
#
# The same OAT that authenticated your host's `docker login` is fine.
EXO_UPDATER_OCI_AUTH_TOKEN=

# ------------------------------------------------------------------
# Slack connector (optional)
# ------------------------------------------------------------------

# Set these only if integrating with Slack. Leave empty to disable
# the connector.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Runtime configs generated by setup.sh from the .example templates.
# These contain secrets (ENCRYPTION_KEY, jwt_secret, OAT, admin
# password) and must never be committed.
.env
config.toml
config.proxy.toml
Caddyfile

# Bring-your-own TLS material.
certs/

# Backup archives written by backup.sh (contain .env secrets + volume data).
backups/

# Editor / OS noise.
.DS_Store
*.swp
*.swo
.idea/
.vscode/

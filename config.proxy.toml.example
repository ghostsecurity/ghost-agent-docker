# Credential-proxy config. Bind-mounted into the credential-proxy
# container at /etc/exo/config.proxy.toml.
#
# Copy this file to `config.proxy.toml`. No values need editing -
# the defaults are fixed by the docker-compose network topology.

[server]
# MITM data-plane listener. Workers' DNS interception sends every
# public hostname here.
addr = ":443"

[database]
mongo_uri = "mongodb://database:27017/?replicaSet=rs0&directConnection=true"
mongo_database = "exo"

[proxy]
# Bridge-only identity. The MITM and control-plane listeners are
# not exposed outside the docker network; workers reach this proxy
# only via the DNS interception flow.
public_url = "https://credential-proxy"
internal_listen_addr = ":8444"
tls_dev_dir = "/var/lib/exo/tls"
gateway_cert_dir = "/var/lib/exo/tls"
per_run_burst          = 100
per_run_refill_per_sec = 20

# DNS server. Worker resolv.conf points here; the server answers
# A/AAAA for public hostnames with the proxy's own bridge IP (so
# MITM can authorize each request against the per-credential
# allowed-hosts list) and forwards stack-internal names to docker's
# embedded resolver at 127.0.0.11.
dns_listen_addr = ":53"
dns_proxy_ip   = "172.28.0.10"
dns_upstream   = "127.0.0.11:53"

# Public CA material published to the tls-public volume on startup.
# The worker container mounts that volume read-only to validate
# MITM certs. Private keys stay on the tls volume and never reach
# the worker.
tls_ca_public_path = "/var/lib/exo/tls-public/ca.crt"
service_ca_public_path = "/var/lib/exo/tls-public/service-ca.crt"
